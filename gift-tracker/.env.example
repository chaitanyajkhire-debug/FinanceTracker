# Optional. The app ships with the party's Supabase project baked into
# src/lib/config.ts (a publishable key, safe for the browser), so it runs
# with no configuration at all. Set these only to point a deployment at a
# different Supabase project.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
