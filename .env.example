# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key - server-side only, never expose to the browser.
# Used by the daily cron refresh job to update all holdings.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret the /api/cron/refresh route checks for.
# Generate with: openssl rand -hex 32
# Set the same value as an Environment Variable named CRON_SECRET in Vercel -
# Vercel automatically sends it as `Authorization: Bearer $CRON_SECRET` to Cron Jobs.
CRON_SECRET=change-me
